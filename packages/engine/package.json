{
  "name": "@pop-party/engine",
  "version": "1.0.0",
  "description": "Public runtime and authoring infrastructure for Pop Party games.",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./game": {
      "types": "./src/server/game-definition-runtime.d.ts",
      "default": "./src/server/game-definition-runtime.js"
    },
    "./plugin": {
      "types": "./src/server/game-plugin-runtime.d.ts",
      "default": "./src/server/game-plugin-runtime.js"
    },
    "./content/schema": "./dist/shared/content-bundle-schema.js",
    "./content/snapshot": "./dist/server/content-snapshot-runtime.js",
    "./content/store": "./dist/server/revisioned-content-store-runtime.js",
    "./content/local": "./dist/server/local-content-bundle-provider.js",
    "./content/github": "./dist/server/github-content-bundle-store.js",
    "./content/github-app": "./dist/server/github-app-credential-runtime.js",
    "./content/github-git": "./dist/server/github-git-data-runtime.js",
    "./content/environment": "./dist/server/content-store-environment-runtime.js",
    "./content/admin": "./dist/server/content-admin-handlers-runtime.js",
    "./rooms/content-pin": "./dist/server/room-content-pin-runtime.js",
    "./security/admin": "./dist/server/admin-auth-runtime.js",
    "./security/audit": "./dist/server/admin-audit-runtime.js",
    "./security/runtime-capabilities": "./dist/server/runtime-capability-runtime.js",
    "./security/svg": "./dist/server/svg-sanitizer.js"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
