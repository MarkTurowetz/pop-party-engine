{
  "name": "@pop-party/engine",
  "version": "1.3.38",
  "description": "Public runtime and authoring infrastructure for Pop Party games.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkTurowetz/pop-party-engine.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/MarkTurowetz/pop-party-engine#readme",
  "bugs": {
    "url": "https://github.com/MarkTurowetz/pop-party-engine/issues"
  },
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "pop-party": "bin/pop-party.js"
  },
  "exports": {
    ".": "./index.js",
    "./game": {
      "types": "./src/server/game-definition-runtime.d.ts",
      "default": "./src/server/game-definition-runtime.js"
    },
    "./plugin": {
      "types": "./src/server/game-plugin-runtime.d.ts",
      "default": "./src/server/game-plugin-runtime.js"
    },
    "./server": {
      "types": "./src/server/index.d.ts",
      "default": "./src/server/index.js"
    },
    "./server/web-service": {
      "types": "./src/server/web-service-runtime.d.ts",
      "default": "./src/server/web-service-runtime.js"
    },
    "./server/readiness": {
      "types": "./src/server/game-readiness-runtime.d.ts",
      "default": "./src/server/game-readiness-runtime.js"
