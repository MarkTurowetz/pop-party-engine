  "files": [
    "bin/*.js",
    "src/**/*.js",
    "src/**/*.d.ts",
    "web/**/*",
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
