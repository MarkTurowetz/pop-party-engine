{
  "name": "@pop-party/engine",
  "version": "1.0.0",
  "description": "Public runtime and authoring infrastructure for Pop Party games.",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "pop-party": "bin/pop-party.js"
  },
  "exports": {
    ".": "./index.js",
    "./game": {
      "types": "./src/server/game-definition-runtime.d.ts",
      "default": "./src/server/game-definition-runtime.js"
    },
    "./plugin": {
      "types": "./src/server/game-plugin-runtime.d.ts",
      "default": "./src/server/game-plugin-runtime.js"
    },
    "./server": {
      "types": "./src/server/index.d.ts",
      "default": "./src/server/index.js"
    },
    "./server/web-service": {
      "types": "./src/server/web-service-runtime.d.ts",
      "default": "./src/server/web-service-runtime.js"
    },
    "./client": {
      "types": "./src/client/index.d.ts",
      "default": "./src/client/index.js"
    },
    "./client/http": {
      "types": "./src/client/http.d.ts",
      "default": "./src/client/http.js"
    },
    "./client/layout-states": {
      "types": "./src/shared/controller-layout-states.d.ts",
      "default": "./src/shared/controller-layout-states.js"
    },
    "./testing": {
      "types": "./src/testing/index.d.ts",
      "default": "./src/testing/index.js"
    },
    "./tooling": {
      "types": "./src/tooling/index.d.ts",
      "default": "./src/tooling/index.js"
    },
    "./art/lifecycle": {
      "types": "./src/shared/lifecycle-labels.d.ts",
      "default": "./src/shared/lifecycle-labels.js"
    },
    "./art/timeline": {
      "types": "./src/shared/timeline-model.d.ts",
      "default": "./src/shared/timeline-model.js"
    },
    "./art/architecture": {
      "types": "./src/shared/art-timeline-architecture.d.ts",
      "default": "./src/shared/art-timeline-architecture.js"
    },
    "./art/components": {
      "types": "./src/shared/art-component-schema.d.ts",
      "default": "./src/shared/art-component-schema.js"
    },
    "./content/schema": {
      "types": "./src/shared/content-bundle-schema.d.ts",
      "default": "./src/shared/content-bundle-schema.js"
    },
    "./content/snapshot": {
      "types": "./src/server/content-snapshot-runtime.d.ts",
      "default": "./src/server/content-snapshot-runtime.js"
    },
    "./content/store": {
      "types": "./src/server/revisioned-content-store-runtime.d.ts",
      "default": "./src/server/revisioned-content-store-runtime.js"
    },
    "./content/local": {
      "types": "./src/server/local-content-bundle-provider.d.ts",
      "default": "./src/server/local-content-bundle-provider.js"
    },
    "./content/github": {
      "types": "./src/server/github-content-bundle-store.d.ts",
      "default": "./src/server/github-content-bundle-store.js"
    },
    "./content/github-app": {
      "types": "./src/server/github-app-credential-runtime.d.ts",
      "default": "./src/server/github-app-credential-runtime.js"
    },
    "./content/github-git": {
      "types": "./src/server/github-git-data-runtime.d.ts",
      "default": "./src/server/github-git-data-runtime.js"
    },
    "./content/environment": {
      "types": "./src/server/content-store-environment-runtime.d.ts",
      "default": "./src/server/content-store-environment-runtime.js"
    },
    "./content/admin": {
      "types": "./src/server/content-admin-handlers-runtime.d.ts",
      "default": "./src/server/content-admin-handlers-runtime.js"
    },
    "./rooms/content-pin": {
      "types": "./src/server/room-content-pin-runtime.d.ts",
      "default": "./src/server/room-content-pin-runtime.js"
    },
    "./security/admin": {
      "types": "./src/server/admin-auth-runtime.d.ts",
      "default": "./src/server/admin-auth-runtime.js"
    },
    "./security/audit": {
      "types": "./src/server/admin-audit-runtime.d.ts",
      "default": "./src/server/admin-audit-runtime.js"
    },
    "./security/runtime-capabilities": {
      "types": "./src/server/runtime-capability-runtime.d.ts",
      "default": "./src/server/runtime-capability-runtime.js"
    },
    "./security/svg": {
      "types": "./src/server/svg-sanitizer.d.ts",
      "default": "./src/server/svg-sanitizer.js"
    }
  },
  "files": [
    "bin/*.js",
    "src/**/*.js",
    "src/**/*.d.ts",
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
