{
  "name": "party-game-template",
  "version": "1.0.17",
  "private": true,
  "description": "Server-backed toolkit for building stage and controller party games.",
  "scripts": {
    "build": "npm run build-info",
    "build:assets": "vite build",
    "build:stamp": "node build-version.js",
    "build:shared": "tsc -p tsconfig.shared.json",
    "build:engine-package": "node scripts/build-engine-package.js",
    "build-info": "npm run build:assets && npm run build:stamp",
    "build-info:next": "npm run build:assets && npm run build:stamp -- --next",
    "check": "npm run check:shared-fresh && npm run typecheck && npm run lint && npm run test && npm run check:engine-package && npm run build:assets && npm run smoke:build-assets && npm run check-text-rendering && npm run check:frontend-boundaries && npm run check:animation-authority && npm run check:controller-layout-authority && npm run check:answer-bubble-lifecycle && npm run check:stage-background-authority && npm run smoke:routes",
    "check:shared-fresh": "node checks/check-shared-fresh.js",
    "check:engine-package": "node checks/check-engine-package.js",
    "check:frontend-boundaries": "node checks/check-frontend-boundaries.js",
    "check:animation-authority": "node checks/check-animation-command-authority.js",
    "check:controller-layout-authority": "node checks/check-controller-layout-authority.js",
    "check:answer-bubble-lifecycle": "node checks/check-answer-bubble-lifecycle.js",
    "check:stage-background-authority": "node checks/check-stage-background-authority.js",
    "content:validate": "node checks/validate-content-bundle.js",
    "content:export-legacy": "node checks/export-legacy-content-bundle.js",
    "content:bootstrap-github": "node checks/bootstrap-github-content-store.js",
    "check-text-rendering": "node checks/check-text-rendering.js",
    "lint": "eslint \"client/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"client/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"client/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"client/**/*.{ts,tsx}\"",
    "prestart": "npm run build:assets",
    "start": "node server.js",
    "dev": "node server.js",
    "preview": "node server.js",
    "smoke:build-assets": "node checks/check-vite-assets.js",
    "smoke:routes": "node checks/smoke-routes.js",
    "sync-game-data": "node sync-game-data.js",
    "split:baseline": "node checks/split-baseline.js",
    "split:audit-history": "node checks/split-baseline.js --audit-history",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.0"
  }
}
