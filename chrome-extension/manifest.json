{
  "manifest_version": 3,
  "name": "Flip 7 Controller Spawner",
  "version": "1.0.0",
  "description": "Spawn multiple Flip 7 Party controller windows and tap random visible buttons across them.",
  "action": {
    "default_title": "Flip 7 Spawner",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "system.display",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
