{
  "manifest_version": 3,
  "name": "Party Game Controller Spawner",
  "version": "1.0.0",
  "description": "Spawn multiple Party Game Template controller windows and tap random game options across them.",
  "action": {
    "default_title": "Controller Spawner",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "spawn-controllers": {
      "suggested_key": {
        "default": "Ctrl+Alt+Shift+1",
        "mac": "Command+Alt+Shift+1"
      },
      "description": "Spawn controller windows"
    },
    "tap-random-option": {
      "suggested_key": {
        "default": "Ctrl+Alt+Shift+2",
        "mac": "Command+Alt+Shift+2"
      },
      "description": "Tap a random visible controller option"
    },
    "submit-random-text": {
      "suggested_key": {
        "default": "Ctrl+Alt+Shift+3",
        "mac": "Command+Alt+Shift+3"
      },
      "description": "Submit random text in controllers"
    }
  },
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "system.display",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
