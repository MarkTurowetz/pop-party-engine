{
  "manifest_version": 3,
  "name": "Party Game Controller Spawner",
  "version": "1.0.2",
  "description": "Spawn multiple Party Game Template controller windows and tap random game options across them.",
  "action": {
    "default_title": "Controller Spawner",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "hotkeys.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "spawn-controllers": {
      "description": "Spawn controller windows"
    },
    "tap-random-option": {
      "description": "Tap a random visible controller option"
    },
    "submit-random-text": {
      "description": "Submit random text in controllers"
    }
  },
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "system.display",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
